# ---------------------------------------------------------------------------
# Universe configuration (Phase 2)
# ---------------------------------------------------------------------------
# When unset, the server loads the first file that exists:
#   1. challenge p2/universe-config.json  (Phase 2 extended config, 12 links)
#   2. challenge p1/universe-config.json  (Phase 1 baseline)
#   3. universe-config.json               (repo root fallback)
# UNIVERSE_CONFIG_PATH=challenge p2/universe-config.json

# Optional: canonical site URL for Open Graph metadata (defaults to https://relic.inusha.me)
# NEXT_PUBLIC_SITE_URL=https://relic.inusha.me

# Server-side error tracking (optional)
# SENTRY_DSN=https://examplePublicKey@o.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Build-time only: upload source maps + create releases during `next build` (Vercel).
# Without this, Sentry runtime error reporting still works; stack traces stay minified.
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Client-side error tracking (optional; use the same DSN as SENTRY_DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Vercel CLI / GitHub Actions deploy (set as repository secrets)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# Phase 2 — Chimera Co-Pilot
# ---------------------------------------------------------------------------

# Base URL for the Chimera live network service
CHIMERA_API_BASE_URL=https://chimera.launch26.space

# Team API key — required for GET /state (server-side only; never expose to browser)
# Set the real key in your local .env (NOT committed to git)
CHIMERA_TEAM_KEY=your-team-key-here

# ---------------------------------------------------------------------------
# NL parser LLM fallback (optional)
# ---------------------------------------------------------------------------
# The hybrid parser resolves routing requests with a deterministic rules layer
# first. When it can't confidently identify both planets, it can fall back to an
# LLM. Disabled by default (rules-only) so CI stays offline and deterministic.
#
# Provider selection: off (default) | ollama | gemini
# CHIMERA_LLM_PROVIDER=ollama

# Ollama (local, no API key). Requires `ollama serve` running locally.
# OLLAMA_BASE_URL=http://localhost:11434
# CHIMERA_LLM_MODEL=qwen3:4b

# Google Gemini (needs an API key). When CHIMERA_LLM_PROVIDER=gemini:
# CHIMERA_LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your-gemini-key-here
