# Optional: override universe config file path (defaults to ./universe-config.json)
# UNIVERSE_CONFIG_PATH=/path/to/universe-config.json

# Optional: canonical site URL for Open Graph metadata (defaults to https://relic.inusha.me)
# NEXT_PUBLIC_SITE_URL=https://relic.inusha.me

# Server-side error tracking (optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Client-side error tracking (optional; use the same DSN as SENTRY_DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Vercel CLI / GitHub Actions deploy (set as repository secrets)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# Phase 2 — Chimera Co-Pilot
# ---------------------------------------------------------------------------

# Base URL for the Chimera live network service
CHIMERA_API_BASE_URL=https://chimera.launch26.space

# Team API key — required for GET /state (server-side only; never expose to browser)
# Set the real key in your local .env (NOT committed to git)
CHIMERA_TEAM_KEY=your-team-key-here

# Optional: AI Gateway API key for the LLM NL-parser fallback
# AI_GATEWAY_API_KEY=

